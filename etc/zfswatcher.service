#
# zfswatcher unit configuration file for systemd(8)
#
# The daemon runs as the unprivileged system user "zfswatcher". If you need
# the ledctl(8) utility from the ledmon package for the enclosure LEDs, which
# requires root, run "systemctl edit zfswatcher" and add:
#
#   [Service]
#   User=root
#   Group=root
#

[Unit]
Description=ZFS pool monitoring and notification daemon
Documentation=man:zfswatcher(8) https://github.com/tantefred/zfswatcher
After=zfs-import.target zfs-import-cache.service zfs-import-scan.service

[Service]
Type=simple
ExecStart=/usr/sbin/zfswatcher
ExecReload=/bin/kill -HUP $MAINPID
User=zfswatcher
Group=zfswatcher
# Creates /var/log/zfswatcher owned by the service user.
LogsDirectory=zfswatcher
Restart=on-failure
RestartSec=5

# The web interface listens on an unprivileged port by default (see "bind" in
# the configuration). To use a port below 1024 without being root, run
# "systemctl edit zfswatcher" and add:
#
#   [Service]
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. The daemon only runs zpool/zfs, reads their output and writes logs.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
