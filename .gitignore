/zfswatcher-*.rpm
/zfswatcher_*.deb
/zfswatcher_*.changes
/zfswatcher_*.buildinfo

# Debian packaging build leftovers
/debian/files
/debian/*.debhelper.log
/debian/*.substvars
/debian/.debhelper/
/debian/zfswatcher/

# IDE and editor files
/.idea/
/.vscode/
*.swp
*~
.DS_Store
