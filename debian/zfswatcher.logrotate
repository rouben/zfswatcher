/var/log/zfswatcher/*.log
{
	# the logs belong to the unprivileged service user
	su zfswatcher zfswatcher
	create 0640 zfswatcher zfswatcher
	rotate 6
	monthly
	missingok
	notifempty
	compress
	delaycompress
	postrotate
		# SIGHUP makes zfswatcher reopen its log files
		systemctl kill --signal=HUP zfswatcher.service >/dev/null 2>&1 || true
	endscript
}
