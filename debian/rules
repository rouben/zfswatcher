#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

# debhelper (compat 13) points HOME into debian/.debhelper, so Go downloads its
# module cache there. Go makes that cache read-only by default, which makes the
# final "rm -rf debian/.debhelper" of dh_clean fail with "Permission denied".
export GOFLAGS += -modcacherw

# The binary reports the package version without the Debian revision, which
# is also right for development builds like 0.5.0+git20261122153012.a6cae3c-1.
export PKGVERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/-[^-]*$$//')

%:
	dh $@

# Safety net for a read-only cache left behind by an earlier run.
override_dh_clean:
	-chmod -R u+w debian/.debhelper
	dh_clean

# Go binaries carry compressed DWARF sections, which dwz cannot process
# ("Found compressed .debug_abbrev section"). Skip dwz, as Go packages do.
override_dh_dwz:
